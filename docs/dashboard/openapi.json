{
  "components" : {
    "schemas" : {
      "CategorySales" : {
        "description" : "Sales grouped by product category",
        "properties" : {
          "category" : {
            "description" : "Product category, Sem categoria for products no longer registered",
            "example" : "Pizza",
            "type" : "string"
          },
          "quantity" : {
            "description" : "Units sold in the category",
            "example" : 42,
            "format" : "int64",
            "type" : "integer"
          },
          "revenue" : {
            "description" : "Revenue of the category items, order discount applied",
            "example" : 1890.0,
            "type" : "number"
          }
        },
        "required" : [ "category", "quantity", "revenue" ],
        "type" : "object"
      },
      "FormaPagamento" : {
        "description" : "Payment method of the order",
        "enum" : [ "DINHEIRO", "PIX", "CARTAO_CREDITO", "CARTAO_DEBITO" ],
        "example" : "PIX",
        "type" : "string"
      },
      "Granularity" : {
        "description" : "Time series bucket: DAY, WEEK (starting on Monday) or MONTH",
        "enum" : [ "DAY", "WEEK", "MONTH" ],
        "type" : "string"
      },
      "Kpis" : {
        "description" : "General sales indicators for the period",
        "properties" : {
          "averageTicket" : {
            "description" : "Revenue divided by the number of orders, 0 when there are none",
            "example" : 41.15,
            "type" : "number"
          },
          "from" : {
            "description" : "First day of the period actually used",
            "example" : "2026-10-01",
            "format" : "date",
            "type" : "string"
          },
          "orders" : {
            "description" : "Number of orders in the period",
            "example" : 30,
            "format" : "int64",
            "type" : "integer"
          },
          "revenue" : {
            "description" : "Sum of the whole order totals, discounts applied (with a category filter, of the orders holding the category, not only its items)",
            "example" : 1234.5,
            "type" : "number"
          },
          "to" : {
            "description" : "Last day of the period actually used",
            "example" : "2026-10-31",
            "format" : "date",
            "type" : "string"
          }
        },
        "required" : [ "averageTicket", "from", "orders", "revenue", "to" ],
        "type" : "object"
      },
      "ProductRanking" : {
        "description" : "Ranking criterion: QUANTITY (units sold) or REVENUE",
        "enum" : [ "QUANTITY", "REVENUE" ],
        "type" : "string"
      },
      "ProductSales" : {
        "description" : "Sales of one product",
        "properties" : {
          "category" : {
            "description" : "Product category, Sem categoria for products no longer registered",
            "example" : "Pizza",
            "type" : "string"
          },
          "name" : {
            "description" : "Product name as recorded in the order",
            "example" : "Calabresa",
            "type" : "string"
          },
          "productId" : {
            "description" : "Id of the product",
            "example" : "6711f0c2a1b2c3d4e5f60718",
            "type" : "string"
          },
          "quantity" : {
            "description" : "Units sold",
            "example" : 18,
            "format" : "int64",
            "type" : "integer"
          },
          "revenue" : {
            "description" : "Revenue of the product, order discount applied",
            "example" : 819.0,
            "type" : "number"
          }
        },
        "required" : [ "category", "name", "productId", "quantity", "revenue" ],
        "type" : "object"
      },
      "SalesPoint" : {
        "description" : "Sales of one period of the time series",
        "properties" : {
          "orders" : {
            "description" : "Number of orders in the bucket",
            "example" : 8,
            "format" : "int64",
            "type" : "integer"
          },
          "period" : {
            "description" : "First day of the bucket (day, Monday of the week or first day of the month)",
            "example" : "2026-10-06",
            "format" : "date",
            "type" : "string"
          },
          "revenue" : {
            "description" : "Revenue of the bucket, discounts applied",
            "example" : 350.0,
            "type" : "number"
          }
        },
        "required" : [ "orders", "period", "revenue" ],
        "type" : "object"
      },
      "StatusCount" : {
        "description" : "Number of orders in one status",
        "properties" : {
          "count" : {
            "description" : "Number of orders in the status",
            "example" : 5,
            "format" : "int64",
            "type" : "integer"
          },
          "status" : {
            "description" : "Order status",
            "enum" : [ "RECEBIDO", "EM_PREPARACAO", "PRONTO", "SAIU_PARA_ENTREGA", "RETIRADO", "FINALIZADO", "CANCELADO" ],
            "example" : "EM_PREPARACAO",
            "type" : "string"
          }
        },
        "required" : [ "count", "status" ],
        "type" : "object"
      }
    }
  },
  "info" : {
    "description" : "Sales indicators of the Pediu Patrão ordering system. Session login required.",
    "title" : "Pediu Patrão - Dashboard API",
    "version" : "1.0"
  },
  "openapi" : "3.1.0",
  "paths" : {
    "/api/dashboard/kpis" : {
      "get" : {
        "operationId" : "kpis",
        "parameters" : [ {
          "description" : "First day of the period, inclusive (defaults to 29 days before to)",
          "example" : "2026-10-01",
          "in" : "query",
          "name" : "from",
          "required" : false,
          "schema" : {
            "description" : "First day of the period, inclusive (defaults to 29 days before to)",
            "example" : "2026-10-01",
            "format" : "date",
            "type" : "string"
          }
        }, {
          "description" : "Last day of the period, inclusive (defaults to today)",
          "example" : "2026-10-31",
          "in" : "query",
          "name" : "to",
          "required" : false,
          "schema" : {
            "description" : "Last day of the period, inclusive (defaults to today)",
            "example" : "2026-10-31",
            "format" : "date",
            "type" : "string"
          }
        }, {
          "description" : "Filter by order status (sales metrics ignore CANCELADO when absent)",
          "example" : "FINALIZADO",
          "in" : "query",
          "name" : "status",
          "required" : false,
          "schema" : {
            "description" : "Filter by order status (sales metrics ignore CANCELADO when absent)",
            "enum" : [ "RECEBIDO", "EM_PREPARACAO", "PRONTO", "SAIU_PARA_ENTREGA", "RETIRADO", "FINALIZADO", "CANCELADO" ],
            "example" : "FINALIZADO",
            "type" : "string"
          }
        }, {
          "description" : "Filter by product category (product type, case-insensitive, blank means all). Order indicators (kpis, sales-trend, orders-status) keep whole orders holding at least one item of the category; item indicators (sales-by-category, top-products) keep only its items",
          "example" : "Pizza",
          "in" : "query",
          "name" : "category",
          "required" : false,
          "schema" : {
            "description" : "Filter by product category (product type, case-insensitive, blank means all). Order indicators (kpis, sales-trend, orders-status) keep whole orders holding at least one item of the category; item indicators (sales-by-category, top-products) keep only its items",
            "example" : "Pizza",
            "maxLength" : 50,
            "minLength" : 0,
            "pattern" : "^\\P{Cntrl}*$",
            "type" : "string"
          }
        }, {
          "description" : "Filter by payment method",
          "example" : "PIX",
          "in" : "query",
          "name" : "paymentMethod",
          "required" : false,
          "schema" : {
            "$ref" : "#/components/schemas/FormaPagamento"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Kpis"
                }
              }
            },
            "description" : "Sales indicators successfully retrieved"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "properties" : {
                    "detail" : {
                      "example" : "O período consultado deve ter no máximo 366 dias.",
